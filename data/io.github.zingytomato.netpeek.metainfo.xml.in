<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.zingytomato.netpeek</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>NetPeek</name>
  <summary>See what's on your network</summary>
  <description>
    <p>
      NetPeek is a simple network scanner that helps you
      discover active devices on your local network.
    </p>
  </description>
  <developer id="io.github.zingytomato">
    <name>ZingyTomato</name>
  </developer>
  <url type="homepage">https://github.com/zingytomato/netpeek</url>
  <url type="vcs-browser">https://github.com/zingytomato/netpeek</url>
  <url type="bugtracker">https://github.com/zingytomato/netpeek/issues</url>
  <launchable type="desktop-id">io.github.zingytomato.netpeek.desktop</launchable>
  <categories>
    <category>Network</category>
    <category>System</category>
  </categories>
  <keywords>
    <keyword>Gnome</keyword>
    <keyword>GTK</keyword>
    <keyword>Networking</keyword>
    <keyword>Internet</keyword>
    <keyword>Scanner</keyword>
  </keywords>
  <content_rating type="oars-1.1" />
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <branding>
    <color type="primary" scheme_preference="dark">#005577</color>
    <color type="primary" scheme_preference="light">#0088cc</color>
  </branding>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/ZingyTomato/NetPeek/refs/heads/master/data/screenshots/1.png</image>
      <caption>Home screen</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/ZingyTomato/NetPeek/refs/heads/master/data/screenshots/2.png</image>
      <caption>Scan in Progress</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/ZingyTomato/NetPeek/refs/heads/master/data/screenshots/3.png</image>
      <caption>Scan Results</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/ZingyTomato/NetPeek/refs/heads/master/data/screenshots/4.png</image>
      <caption>List View</caption>
    </screenshot>
  </screenshots>
  <releases>
    <release version="0.3.0" date="2026-07-25">
      <url type="details">https://github.com/zingytomato/NetPeek/releases/tag/v0.3.0</url>
      <description>
        <p>Version 0.3.0</p>
        <ul>
          <li>New Deep Scan mode for additional information like OS identification, software versions and more.</li>
          <li>Expanded service detection for common self-hosted and DevOps services (MySQL, PostgreSQL, Redis, Home Assistant, Plex, etc.).</li>
          <li>Improved UI adaptability for smaller screens.</li>
        </ul>
      </description>
    </release>
    <release version="0.2.9" date="2026-07-19">
      <url type="details">https://github.com/zingytomato/NetPeek/releases/tag/v0.2.9</url>
      <description>
        <p>Version 0.2.9</p>
        <ul>
          <li>Refreshed the app icon with a contemporary, flat style.</li>
          <li>Redesigned the light, dark and system style switcher with visual swatches.</li>
          <li>Cockpit instances are now detected and shown alongside SMB shares in a combined Services row.</li>
          <li>Header actions move into a bottom bar when the window is narrow.</li>
          <li>Custom device names now apply retroactively to previous scans.</li>
          <li>Added an Open Folder shortcut to the CSV export notification.</li>
          <li>Streamlined notifications, keeping only copy, export and error messages.</li>
          <li>The active sort option is now highlighted and shows its direction.</li>
          <li>Sorting is disabled while scanning and when no devices are found.</li>
          <li>Added a Services column to the list view and made narrow lists scroll horizontally.</li>
          <li>Centered the network preset buttons and set a minimum window size for a consistent layout.</li>
          <li>Fixed manually entered thread counts not being applied, and added a confirm button to the IP and thread fields.</li>
          <li>Input fields no longer keep focus after use, and the IP entry no longer shows a focus ring or apply button on launch.</li>
          <li>Device cards no longer highlight on hover.</li>
        </ul>
      </description>
    </release>
    <release version="0.2.8" date="2026-07-18">
      <url type="details">https://github.com/zingytomato/NetPeek/releases/tag/v0.2.8</url>
      <description>
        <p>Version 0.2.8</p>
        <ul>
          <li>Fixed unreliable network auto-detection.</li>
          <li>Added scan history with a Previous Scans dialog.</li>
          <li>Added dark mode support.</li>
          <li>Unified sorting between card and list views.</li>
          <li>Improved responsive layout on narrow windows.</li>
        </ul>
      </description>
    </release>
    <release version="0.2.7" date="2026-05-18">
      <url type="details">https://github.com/zingytomato/NetPeek/releases/tag/v0.2.7</url>
      <description>
        <p>Version 0.2.7</p>
        <ul>
          <li>Updated to GNOME 50 runtime.</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
