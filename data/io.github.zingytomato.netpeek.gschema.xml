<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="netpeek">
	<schema id="io.github.zingytomato.netpeek" path="/io/github/zingytomato/netpeek/">
    <key name="window-width" type="i">
      <default>700</default>
      <summary>Default window width</summary>
      <description>Default window width</description>
    </key>
    <key name="window-height" type="i">
      <default>1000</default>
      <summary>Default window height</summary>
      <description>Default window height</description>
    </key>
    <key name="window-maximized" type="b">
      <default>false</default>
      <summary>Default window maximized behaviour</summary>
      <description>Not maximised by default</description>
    </key>
    <key name="color-scheme" type="s">
      <default>'default'</default>
      <summary>Preferred color scheme</summary>
      <description>One of "default" (follow system), "light", or "dark".</description>
    </key>
    <key name="view-mode" type="s">
      <default>'cards'</default>
      <summary>Results view mode</summary>
      <description>One of "cards" or "list".</description>
    </key>
    <key name="last-ip-range" type="s">
      <default>''</default>
      <summary>Last used IP range</summary>
      <description>The IP range entered in the last scan, restored on startup.</description>
    </key>
    <key name="last-preset" type="s">
      <default>'auto'</default>
      <summary>Last selected preset</summary>
      <description>The preset selected in the split button, restored on startup. "auto" for auto-detect, or an IP range like "192.168.1.0/24".</description>
    </key>
    <key name="deep-scan" type="b">
      <default>false</default>
      <summary>Enable deep scan mode</summary>
      <description>When enabled, retrieves more detailed system information like OS name, HTTP server etc.</description>
    </key>
    <key name="thread-count" type="i">
      <default>100</default>
      <summary>Thread count for scanning</summary>
      <description>Number of concurrent worker threads to use while scanning (1–500).</description>
      <range min="1" max="500"/>
    </key>
    <key name="history-filter-mode" type="s">
      <default>'all'</default>
      <summary>Last selected history filter</summary>
      <description>One of "all", "today", "yesterday", "7d", "30d", or "custom".</description>
    </key>
    <key name="history-custom-start" type="s">
      <default>''</default>
      <summary>Custom filter start date</summary>
      <description>ISO date string for custom filter start, e.g. "2026-01-15".</description>
    </key>
    <key name="history-custom-end" type="s">
      <default>''</default>
      <summary>Custom filter end date</summary>
      <description>ISO date string for custom filter end, e.g. "2026-01-31".</description>
    </key>
	</schema>
</schemalist>
