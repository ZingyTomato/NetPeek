msgstr "Rakenda"

#: src/gtk/history_dialog.ui:198 src/gtk/history_dialog.ui:210
msgid "Scroll to top"
msgstr "Keri loendi algusesse"

#: src/gtk/history_dialog.ui:223 src/pages/history.py:310
msgid "No previous scans"
msgstr "Eelmisi skaneerimisi ei leidu"

#: src/gtk/history_dialog.ui:224 src/pages/history.py:311
msgid "Your scan history will appear here."
msgstr "Sinu varasemad skaneerimised saavad olema nähtavad siin."

#: src/gtk/history_dialog.ui:244 src/gtk/history_dialog.ui:251
msgid "Previous page"
msgstr "Eelmine leht"

