<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>

  <template class="DeviceCard" parent="AdwBin">
    <property name="width-request">320</property>
    <child>
      <object class="AdwClamp">
        <property name="maximum-size">320</property>
        <property name="tightening-threshold">280</property>

        <child>
          <object class="AdwPreferencesGroup" id="content_group">
            <property name="margin-top">8</property>
            <property name="margin-bottom">8</property>
            <property name="margin-start">8</property>
            <property name="margin-end">8</property>

            <child>
              <object class="AdwEntryRow" id="name_row">
                <property name="title" translatable="yes">Name</property>
                <signal name="entry-activated" handler="on_name_apply"/>
                <child>
                  <object class="GtkButton" id="name_apply_button">
                    <property name="icon-name">object-select-symbolic</property>
                    <property name="visible">false</property>
                    <property name="valign">center</property>
                    <property name="tooltip-text" translatable="yes">Apply name</property>
                    <style>
                      <class name="flat"/>
                    </style>
                    <signal name="clicked" handler="on_name_apply"/>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="new_badge">
                    <property name="label" translatable="yes">New</property>
                    <property name="visible">False</property>
                    <property name="valign">center</property>
                    <style>
                      <class name="accent"/>
                      <class name="caption-heading"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="AdwActionRow" id="ip_row">
                <property name="title">IP Address</property>

                <child type="prefix">
                  <object class="GtkImage">
                    <property name="icon-name">network-wired-symbolic</property>
                  </object>
                </child>

                <child type="suffix">
                  <object class="GtkButton" id="ip_button">
                    <property name="halign">end</property>
                    <property name="valign">center</property>
                    <property name="icon-name">edit-copy-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Click to copy IP</property>
                    <signal name="clicked" handler="on_ip_clicked"/>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="AdwActionRow" id="hostname_row">
                <property name="title" translatable="yes">Hostname</property>

                <child type="prefix">
                  <object class="GtkImage">
                    <property name="icon-name">computer-symbolic</property>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="AdwActionRow" id="ports_row">
                <property name="title" translatable="yes">Ports Open</property>

                <child type="prefix">
                  <object class="GtkImage">
                    <property name="icon-name">network-transmit-receive-symbolic</property>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="AdwActionRow" id="services_row">
                <property name="title" translatable="yes">Services</property>
                <property name="subtitle-lines">1</property>

                <child type="prefix">
                  <object class="GtkImage">
                    <property name="icon-name">folder-remote-symbolic</property>
                  </object>
                </child>

                <child type="suffix">
                  <object class="GtkToggleButton" id="services_expand_button">
                    <property name="icon-name">pan-down-symbolic</property>
                    <property name="valign">center</property>
                    <property name="visible">False</property>
                    <property name="tooltip-text" translatable="yes">Show full service list</property>
                    <style>
                      <class name="flat"/>
                    </style>
                    <signal name="toggled" handler="on_expand_toggled"/>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="AdwActionRow" id="os_row">
                <property name="title" translatable="yes">System Information</property>
                <property name="subtitle-lines">1</property>

                <child type="prefix">
                  <object class="GtkImage">
                    <property name="icon-name">computer-symbolic</property>
                  </object>
                </child>

                <child type="suffix">
                  <object class="GtkToggleButton" id="os_expand_button">
                    <property name="icon-name">pan-down-symbolic</property>
                    <property name="valign">center</property>
                    <property name="visible">False</property>
                    <property name="tooltip-text" translatable="yes">Show full system information</property>
                    <style>
                      <class name="flat"/>
                    </style>
                    <signal name="toggled" handler="on_expand_toggled"/>
                  </object>
                </child>
              </object>
            </child>

          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
