<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>

  <template class="ResultsPage" parent="AdwNavigationPage">
    <property name="title" translatable="yes">Scan results</property>

    <child>
      <object class="AdwBreakpointBin" id="page_breakpoint_bin">
        <property name="width-request">360</property>
        <property name="height-request">200</property>
        <child>
      <object class="AdwToolbarView">
        <property name="bottom-bar-style">raised</property>
        <child type="top">
          <object class="AdwHeaderBar" id="results_header">
            <child type="title">
              <object class="AdwWindowTitle" id="results_title">
                <property name="title" translatable="yes">Scan results</property>
              </object>
            </child>

            <child type="start">
              <object class="GtkButton" id="stop_button">
                <property name="tooltip-text" translatable="yes">Stop the current network scan</property>
                <property name="visible">false</property>
                <property name="child">
                  <object class="AdwButtonContent" id="stop_button_content">
                    <property name="icon-name">process-stop-symbolic</property>
                    <property name="label" translatable="yes">Stop</property>
                    <property name="can-shrink">True</property>
                  </object>
                </property>
                <signal name="clicked" handler="on_stop_clicked"/>
              </object>
            </child>

            <child type="start">
              <object class="GtkButton" id="scan_info_button">
                <property name="icon-name">dialog-information-symbolic</property>
                <property name="tooltip-text" translatable="yes">Scan information</property>
                <property name="sensitive">False</property>
                <signal name="clicked" handler="on_scan_info_clicked"/>
                <accessibility>
                  <property name="label" translatable="yes">Scan information</property>
                </accessibility>
              </object>
            </child>

            <child type="end">
              <object class="GtkBox" id="action_box">

                <child>
                  <object class="GtkButton" id="export_button">
                    <property name="icon-name">document-save-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Export to CSV</property>
                    <signal name="clicked" handler="on_export_clicked"/>
                    <accessibility>
                      <property name="label" translatable="yes">Export to CSV</property>
                    </accessibility>
                  </object>
                </child>

                <child>
                  <object class="GtkToggleButton" id="view_toggle_button">
                    <property name="icon-name">view-list-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Toggle list view</property>
                    <signal name="toggled" handler="on_view_toggle"/>
                  </object>
                </child>

                <child>
                  <object class="GtkMenuButton" id="sort_menu_button">
                    <property name="icon-name">view-sort-ascending-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Sort options</property>
                    <property name="popover">
                      <object class="GtkPopoverMenu">
                        <property name="menu-model">results_view_menu</property>
                      </object>
                    </property>
                    <accessibility>
                      <property name="label" translatable="yes">Sort options</property>
                    </accessibility>
                  </object>
                </child>

                <child>
                  <object class="GtkButton" id="rescan_button">
                    <property name="margin-start">6</property>
                    <property name="child">
                      <object class="AdwButtonContent" id="rescan_button_content">
                        <property name="icon-name">view-refresh-symbolic</property>
                        <property name="label" translatable="yes">Rescan</property>
                        <property name="can-shrink">True</property>
                      </object>
                    </property>
                    <signal name="clicked" handler="on_rescan_clicked"/>
                    <style>
                      <class name="suggested-action"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="GtkStack" id="results_stack">
            <property name="transition-type">crossfade</property>
            <property name="transition-duration">200</property>

            <child>
              <object class="GtkStackPage">
                <property name="name">loading</property>
                <property name="child">
                  <object class="AdwStatusPage">
                    <property name="title" translatable="yes">Scanning network</property>
                    <property name="description" translatable="yes">Discovering devices on your network…</property>
                    <property name="icon-name">network-wireless-acquiring-symbolic</property>

                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">12</property>
                        <property name="halign">center</property>

                        <child>
                          <object class="AdwSpinner" id="spinner">
                            <property name="width-request">48</property>
                            <property name="height-request">48</property>
                            <style>
                              <class name="large"/>
                            </style>
                          </object>
                        </child>

                        <child>
                           <object class="GtkLabel" id="progress_label">
                             <property name="label" translatable="yes">Preparing scan…</property>
                             <property name="ellipsize">end</property>
                             <property name="max-width-chars">48</property>
                             <style>
                               <class name="dim-label"/>
                             </style>
                           </object>
                        </child>

                        <child>
                           <object class="GtkLabel" id="timer_label">
                             <property name="label" translatable="yes">Time elapsed: 00:00</property>
                             <property name="ellipsize">end</property>
                             <style>
                               <class name="dim-label"/>
                             </style>
                           </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>

            <child>
              <object class="GtkStackPage">
                <property name="name">devices</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="vexpand">True</property>

                    <child>
                      <object class="AdwClamp" id="search_clamp">
                        <property name="maximum-size">480</property>
                        <property name="tightening-threshold">400</property>
                        <property name="margin-top">6</property>
                        <property name="margin-bottom">6</property>
                        <property name="margin-start">12</property>
                        <property name="margin-end">12</property>
                        <child>
                          <object class="GtkSearchEntry" id="search_entry">
                            <property name="hexpand">True</property>
                            <property name="placeholder-text" translatable="yes">Search devices</property>
                            <signal name="search-changed" handler="on_search_changed"/>
                            <signal name="stop-search" handler="on_search_stopped"/>
                          </object>
                        </child>
                      </object>
                    </child>

                    <child>
                      <object class="GtkStack" id="devices_content_stack">
                        <property name="transition-type">crossfade</property>
                        <child>
                          <object class="GtkStackPage">
                            <property name="name">results</property>
                            <property name="child">
                              <object class="AdwBreakpointBin" id="devices_breakpoint_bin">
                                <property name="width-request">360</property>
                                <property name="height-request">200</property>
                                <property name="vexpand">True</property>
                                <child>
                                  <object class="AdwBreakpoint">
                                    <condition>max-width: 550sp</condition>
                                    <setter object="flow_box" property="max-children-per-line">1</setter>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkStack" id="view_stack">
                                    <property name="transition-type">crossfade</property>
                                    <child>
                                      <object class="GtkStackPage">
                                        <property name="name">cards</property>
                                        <property name="child">
                                          <object class="GtkScrolledWindow">
                                            <property name="hscrollbar-policy">never</property>
                                            <property name="vscrollbar-policy">automatic</property>
                                            <property name="vexpand">true</property>

                                            <child>
                                              <object class="GtkFlowBox" id="flow_box">
                                                <property name="valign">start</property>
                                                <property name="halign">center</property>
                                                <property name="homogeneous">true</property>
                                                <property name="max-children-per-line">4</property>
                                                <property name="min-children-per-line">1</property>
                                                <property name="row-spacing">12</property>
                                                <property name="column-spacing">8</property>
                                                <property name="margin-top">12</property>
                                                <property name="margin-bottom">24</property>
                                                <property name="margin-start">8</property>
                                                <property name="margin-end">8</property>
                                                <property name="selection-mode">none</property>
                                                <style>
                                                  <class name="device-grid"/>
                                                </style>
                                              </object>
                                            </child>
                                          </object>
                                        </property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkStackPage">
                                        <property name="name">list</property>
                                        <property name="child">
                                          <object class="GtkScrolledWindow" id="list_view">
                                            <property name="hscrollbar-policy">automatic</property>
                                            <property name="vscrollbar-policy">automatic</property>
                                            <property name="vexpand">true</property>
                                          </object>
                                        </property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkStackPage">
                            <property name="name">no_results</property>
                            <property name="child">
                              <object class="AdwStatusPage" id="no_results_page">
                                <property name="title" translatable="yes">No results found</property>
                                <property name="description" translatable="yes">No devices match your search query.</property>
                                <property name="icon-name">edit-find-symbolic</property>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>

            <child>
              <object class="GtkStackPage">
                <property name="name">empty</property>
                <property name="child">
                  <object class="AdwStatusPage" id="empty_page">
                    <property name="title" translatable="yes">No devices found</property>
                    <property name="description" translatable="yes">No devices were found in the specified range.</property>
                    <property name="icon-name">network-wireless-offline-symbolic</property>
                  </object>
                </property>
              </object>
            </child>

            <child>
              <object class="GtkStackPage">
                <property name="name">error</property>
                <property name="child">
                  <object class="AdwStatusPage" id="error_page">
                    <property name="title" translatable="yes">Scan error</property>
                    <property name="description" translatable="yes">An error occurred while scanning the network.</property>
                    <property name="icon-name">dialog-error-symbolic</property>
                    <child>
                      <object class="GtkButton" id="error_rescan_button">
                        <property name="label" translatable="yes">_Try again</property>
                        <property name="use-underline">True</property>
                        <signal name="clicked" handler="on_rescan_clicked"/>
                        <style><class name="suggested-action"/><class name="pill"/></style>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>

        <child type="bottom">
          <object class="AdwBin" id="bottom_bar">
            <property name="visible">False</property>
          </object>
        </child>
      </object>
        </child>
      </object>
    </child>
  </template>

  <menu id="results_view_menu">
    <section>
      <attribute name="label" translatable="yes">Sort by</attribute>
      <item>
        <attribute name="label" translatable="yes">Known</attribute>
        <attribute name="action">view.sort-by</attribute>
        <attribute name="target">known</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">IP address</attribute>
        <attribute name="action">view.sort-by</attribute>
        <attribute name="target">ip</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Hostname</attribute>
        <attribute name="action">view.sort-by</attribute>
        <attribute name="target">hostname</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Custom name</attribute>
        <attribute name="action">view.sort-by</attribute>
        <attribute name="target">custom_name</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Ports</attribute>
        <attribute name="action">view.sort-by</attribute>
        <attribute name="target">ports</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Services</attribute>
        <attribute name="action">view.sort-by</attribute>
        <attribute name="target">services</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">System information</attribute>
        <attribute name="action">view.sort-by</attribute>
        <attribute name="target">os</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Ascending</attribute>
        <attribute name="action">view.ascending</attribute>
      </item>
    </section>
  </menu>
</interface>
