<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>

  <template class="HistoryDialog" parent="AdwDialog">
    <property name="title" translatable="yes">Previous Scans</property>
    <property name="content-width">480</property>
    <property name="content-height">600</property>
    <child>
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <child type="title">
              <object class="AdwWindowTitle">
                <property name="title" translatable="yes">Previous Scans</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkStack" id="history_stack">
            <child>
              <object class="GtkStackPage">
                <property name="name">list</property>
                <property name="child">
                  <object class="GtkOverlay">
                    <child>
                      <object class="GtkScrolledWindow" id="history_scrolled">
                        <property name="vexpand">true</property>
                        <child>
                          <object class="GtkListBox" id="history_list">
                            <property name="selection-mode">none</property>
                            <property name="valign">start</property>
                            <property name="margin-top">12</property>
                            <property name="margin-bottom">48</property>
                            <property name="margin-start">12</property>
                            <property name="margin-end">12</property>
                            <signal name="row-activated" handler="on_scan_row_activated"/>
                            <style>
                              <class name="boxed-list"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child type="overlay">
                      <object class="GtkButton" id="scroll_top_button">
                        <property name="icon-name">go-up-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Scroll to top</property>
                        <property name="halign">end</property>
                        <property name="valign">end</property>
                        <property name="margin-end">12</property>
                        <property name="margin-bottom">12</property>
                        <property name="visible">False</property>
                        <signal name="clicked" handler="on_scroll_top_clicked"/>
                        <style>
                          <class name="osd"/>
                          <class name="circular"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">empty</property>
                <property name="child">
                  <object class="AdwStatusPage">
                    <property name="title" translatable="yes">No Previous Scans</property>
                    <property name="description" translatable="yes">Your scan history will appear here.</property>
                    <property name="icon-name">document-open-recent-symbolic</property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
