<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>

  <template class="ScanMetadataDialog" parent="AdwDialog">
                <property name="title" translatable="yes">Scan information</property>
    <property name="content-width">380</property>
    <property name="content-height">470</property>
    <child>
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <child type="title">
              <object class="AdwWindowTitle">
    <property name="title" translatable="yes">Scan information</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkScrolledWindow">
            <property name="hscrollbar-policy">never</property>
            <child>
              <object class="AdwClamp">
                <property name="maximum-size">360</property>
                <property name="tightening-threshold">320</property>
                <property name="margin-top">24</property>
                <property name="margin-bottom">24</property>
                <property name="margin-start">12</property>
                <property name="margin-end">12</property>
                <child>
                  <object class="AdwPreferencesGroup">
                    <child>
                      <object class="AdwActionRow" id="ip_range_row">
                        <property name="title" translatable="yes">IP range</property>
                        <child type="prefix">
                          <object class="GtkImage">
                            <property name="icon-name">network-wired-symbolic</property>
                          </object>
                        </child>
                        <child type="suffix">
                          <object class="GtkButton" id="ip_copy_button">
                            <property name="halign">end</property>
                            <property name="valign">center</property>
                            <property name="icon-name">edit-copy-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Copy IP range</property>
                            <style>
                              <class name="flat"/>
                            </style>
                            <signal name="clicked" handler="on_ip_range_copy_clicked"/>
                            <accessibility>
                              <property name="label" translatable="yes">Copy IP range</property>
                            </accessibility>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="timestamp_row">
                        <property name="title" translatable="yes">Date taken</property>
                        <child type="prefix">
                          <object class="GtkImage">
                            <property name="icon-name">alarm-symbolic</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="scan_type_row">
                        <property name="title" translatable="yes">Scan type</property>
                        <child type="prefix">
                          <object class="GtkImage">
                            <property name="icon-name">system-search-symbolic</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="duration_row">
                        <property name="title" translatable="yes">Scan duration</property>
                        <property name="visible">false</property>
                        <child type="prefix">
                          <object class="GtkImage">
                            <property name="icon-name">media-playback-start-symbolic</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="new_count_row">
                        <property name="title" translatable="yes">New devices</property>
                        <child type="prefix">
                          <object class="GtkImage">
                            <property name="icon-name">starred-symbolic</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="known_count_row">
                        <property name="title" translatable="yes">Known devices</property>
                        <child type="prefix">
                          <object class="GtkImage">
                            <property name="icon-name">network-wireless-signal-excellent-symbolic</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
